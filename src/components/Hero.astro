---
import { config } from "@/lib/config";
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero__content">
      <div class="hero__brand reveal">
        <a href="/" class="hero__brand-link" aria-label={`${config.productName} — Home`}>
          <img
            src="/assets/logos/innpilot-logo.png"
            alt=""
            width="116"
            height="116"
            class="hero__brand-img"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </a>
      </div>

      <span class="eyebrow reveal">Hospitality Operating System</span>

      <h1 class="hero__title reveal reveal-delay-1">
        Manage your property.<br />
        <span class="hero__title-accent">Sell more rooms.</span>
      </h1>

      <p class="hero__subtitle reveal reveal-delay-2">
        A complete hospitality platform that brings your property operations, direct bookings,
        and distribution together in one connected system.
      </p>

      <div class="hero__actions reveal reveal-delay-3">
        <a href={config.urls.requestAccess} class="btn btn--primary btn--lg" data-track="request_access_click">
          Request Access
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/platform/" class="btn btn--secondary" data-track="explore_platform_click">
          Explore Platform
        </a>
      </div>

      <p class="hero__microcopy reveal reveal-delay-3">
        Built for hotels, resorts, boutique properties, farmstays, and growing hospitality businesses.
      </p>
      <p class="hero__microcopy reveal reveal-delay-3">
        Access is currently invitation-based. <a href={config.urls.requestAccess} class="hero__microcopy-link">Request access</a> or <a href={config.urls.signIn} class="hero__microcopy-link">log in</a>.
      </p>
    </div>

    <div class="hero__visual reveal reveal-delay-2" aria-hidden="true">
      <div class="hero__ui">
        <!-- Browser chrome -->
        <div class="hero__ui-chrome-bar">
          <div class="hero__ui-dots">
            <span class="hero__ui-dot hero__ui-dot--red"></span>
            <span class="hero__ui-dot hero__ui-dot--yellow"></span>
            <span class="hero__ui-dot hero__ui-dot--green"></span>
          </div>
          <span class="hero__ui-url">app.inn-pilot.com</span>
        </div>
        <div class="hero__ui-body">
          <!-- InnPilot sidebar -->
          <div class="hero__ui-sidebar">
            <div class="hero__ui-brand">
              <img src="/assets/logos/innpilot-logo.png" alt="" width="22" height="22" decoding="async" class="hero__ui-brand-logo" />
              <span class="hero__ui-brand-name">InnPilot</span>
            </div>
            <ul class="hero__ui-nav-list">
              <li class="hero__ui-nav-item hero__ui-nav-item--active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                <span>Dashboard</span>
              </li>
              <li class="hero__ui-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Reservations</span>
              </li>
              <li class="hero__ui-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span>Guests</span>
              </li>
              <li class="hero__ui-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v13H3V9z"/><path d="M9 22V12h6v10"/></svg>
                <span>Rooms</span>
              </li>
              <li class="hero__ui-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                <span>Housekeeping</span>
              </li>
              <li class="hero__ui-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                <span>Revenue</span>
              </li>
            </ul>
            <div class="hero__ui-nav-footer">
              <span class="hero__ui-nav-item" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Settings</span>
              </span>
            </div>
          </div>
          <!-- Main content -->
          <div class="hero__ui-main">
            <div class="hero__ui-header">
              <div class="hero__ui-header-left">
                <div class="hero__ui-greeting">
                  <span class="hero__ui-hello">Good morning</span>
                  <span class="hero__ui-name">The Corbett Retreat</span>
                </div>
                <span class="hero__ui-date">Fri, 7 Aug 2026</span>
              </div>
              <div class="hero__ui-chips">
                <span class="hero__ui-chip hero__ui-chip--audit">Night audit complete ✓</span>
                <span class="hero__ui-chip hero__ui-chip--occ">94% Occ</span>
                <span class="hero__ui-chip hero__ui-chip--arrivals">3 arrivals</span>
                <span class="hero__ui-chip hero__ui-chip--departures">2 departures</span>
              </div>
            </div>

            <div class="hero__ui-kpis">
              <div class="hero__ui-kpi">
                <span class="hero__ui-kpi-label">Occupancy</span>
                <span class="hero__ui-kpi-value">94<span class="hero__ui-kpi-unit">%</span></span>
                <span class="hero__ui-kpi-trend hero__ui-kpi-trend--up">▲ +6.2% vs last week</span>
                <span class="hero__ui-kpi-sub">23 / 25 rooms</span>
              </div>
              <div class="hero__ui-kpi">
                <span class="hero__ui-kpi-label">ADR</span>
                <span class="hero__ui-kpi-value">₹6,480</span>
                <span class="hero__ui-kpi-trend hero__ui-kpi-trend--up">▲ +3.1%</span>
                <span class="hero__ui-kpi-sub">Month to date</span>
              </div>
              <div class="hero__ui-kpi">
                <span class="hero__ui-kpi-label">RevPAR</span>
                <span class="hero__ui-kpi-value">₹6,091</span>
                <span class="hero__ui-kpi-trend hero__ui-kpi-trend--up">▲ +8.7%</span>
                <span class="hero__ui-kpi-sub">Month to date</span>
              </div>
              <div class="hero__ui-kpi">
                <span class="hero__ui-kpi-label">In-house</span>
                <span class="hero__ui-kpi-value">23<span class="hero__ui-kpi-unit">/25</span></span>
                <span class="hero__ui-kpi-trend hero__ui-kpi-trend--neutral">2 arrivals today</span>
                <span class="hero__ui-kpi-sub">Guests checked in</span>
              </div>
            </div>

            <div class="hero__ui-grid">
              <div class="hero__ui-card">
                <div class="hero__ui-card-head">
                  <span class="hero__ui-card-title">Revenue · last 14 days</span>
                  <span class="hero__ui-legend">
                    <i class="hero__ui-legend-dot hero__ui-legend-dot--actual"></i>Actual
                    <i class="hero__ui-legend-dot hero__ui-legend-dot--forecast"></i>Forecast
                  </span>
                </div>
                <div class="hero__ui-chart">
                  <div class="hero__ui-chart-plot" style="--chart-cols: 12">
                    <div class="hero__ui-chart-grid" aria-hidden="true"></div>
                    <div class="hero__ui-chart-yscale" aria-hidden="true">
                      <span>₹40K</span>
                      <span>₹20K</span>
                      <span>₹0</span>
                    </div>
                    <div class="hero__ui-bars" aria-hidden="true">
                      <span class="hero__ui-bar hero__ui-bar--actual" style="--h:32%"></span>
                      <span class="hero__ui-bar hero__ui-bar--forecast" style="--h:44%"></span>
                      <span class="hero__ui-bar hero__ui-bar--actual" style="--h:38%"></span>
                      <span class="hero__ui-bar hero__ui-bar--forecast" style="--h:55%"></span>
                      <span class="hero__ui-bar hero__ui-bar--actual" style="--h:48%"></span>
                      <span class="hero__ui-bar hero__ui-bar--forecast" style="--h:66%"></span>
                      <span class="hero__ui-bar hero__ui-bar--actual" style="--h:60%"></span>
                      <span class="hero__ui-bar hero__ui-bar--forecast" style="--h:78%"></span>
                      <span class="hero__ui-bar hero__ui-bar--actual" style="--h:70%"></span>
                      <span class="hero__ui-bar hero__ui-bar--forecast" style="--h:88%"></span>
                      <span class="hero__ui-bar hero__ui-bar--actual" style="--h:82%"></span>
                      <span class="hero__ui-bar hero__ui-bar--forecast hero__ui-bar--today" style="--h:100%"></span>
                    </div>
                  </div>
                  <div class="hero__ui-chart-labels" aria-hidden="true">
                    <span class="hero__ui-chart-label">Mon</span>
                    <span class="hero__ui-chart-label">Tue</span>
                    <span class="hero__ui-chart-label">Wed</span>
                    <span class="hero__ui-chart-label">Thu</span>
                    <span class="hero__ui-chart-label">Fri</span>
                    <span class="hero__ui-chart-label">Sat</span>
                    <span class="hero__ui-chart-label">Sun</span>
                    <span class="hero__ui-chart-label">Mon</span>
                    <span class="hero__ui-chart-label">Tue</span>
                    <span class="hero__ui-chart-label">Wed</span>
                    <span class="hero__ui-chart-label">Thu</span>
                    <span class="hero__ui-chart-label">Fri</span>
                  </div>
                </div>
              </div>

              <div class="hero__ui-card">
                <div class="hero__ui-card-head">
                  <span class="hero__ui-card-title">Today's arrivals</span>
                  <span class="hero__ui-chip hero__ui-chip--count">3 rooms</span>
                </div>
                <ul class="hero__ui-arrivals">
                  <li class="hero__ui-guest">
                    <span class="hero__ui-ava hero__ui-ava--g" aria-hidden="true">A</span>
                    <div class="hero__ui-guest-info">
                      <b class="hero__ui-guest-name">Anita &amp; Raj</b>
                      <small class="hero__ui-guest-room">Garden Suite · 4 nights</small>
                    </div>
                    <span class="hero__ui-tag hero__ui-tag--ready">Ready</span>
                  </li>
                  <li class="hero__ui-guest">
                    <span class="hero__ui-ava hero__ui-ava--c" aria-hidden="true">D</span>
                    <div class="hero__ui-guest-info">
                      <b class="hero__ui-guest-name">David Carter</b>
                      <small class="hero__ui-guest-room">River View · 2 nights</small>
                    </div>
                    <span class="hero__ui-tag hero__ui-tag--wait">Checking</span>
                  </li>
                  <li class="hero__ui-guest">
                    <span class="hero__ui-ava hero__ui-ava--p" aria-hidden="true">M</span>
                    <div class="hero__ui-guest-info">
                      <b class="hero__ui-guest-name">Meera Joshi</b>
                      <small class="hero__ui-guest-room">Studio · 1 night</small>
                    </div>
                    <span class="hero__ui-tag hero__ui-tag--wait">In route</span>
                  </li>
                </ul>
                <span class="hero__ui-arrivals-link">View all arrivals →</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Floating cards -->
      <div class="hero__ui-toasts">
        <div class="hero__ui-float hero__ui-float--a">
          <span class="hero__ui-float-icon hero__ui-float-icon--green">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </span>
          <div class="hero__ui-float-text">
            <b>Payment captured</b>
            <small>₹12,400 · Razorpay</small>
          </div>
        </div>
        <div class="hero__ui-float hero__ui-float--b">
          <span class="hero__ui-float-icon hero__ui-float-icon--purple">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </span>
          <div class="hero__ui-float-text">
            <b>Rate suggestion</b>
            <small>+8% · Fri peak</small>
          </div>
        </div>
      </div>

      <div class="hero__glow"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-height) + var(--space-16));
    padding-bottom: var(--space-20);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: calc(var(--header-height) + var(--space-20));
      padding-bottom: var(--space-24);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: calc(var(--header-height) + var(--space-24));
      padding-bottom: var(--space-32);
    }
  }

  .hero .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1280px) {
    .hero .container {
      flex-direction: row;
      gap: var(--space-16);
      align-items: center;
      max-width: var(--container-2xl);
      padding-inline: var(--space-6);
    }
  }

  .hero__content {
    flex: 1;
    max-width: 600px;
  }

  .hero__title {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-7xl));
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .hero__title-accent {
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__subtitle {
    font-size: clamp(var(--text-base), 2vw, var(--text-lg));
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    max-width: 480px;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero__microcopy {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 480px;
  }

  .hero__microcopy-link {
    color: var(--color-accent);
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero__microcopy-link:hover {
    color: var(--color-accent-light);
  }

  /* ── Hero brand ──────────────────────────────────────────────────────────── */

  .hero__brand {
    margin-bottom: var(--space-8);
  }

  .hero__brand-link {
    display: inline-flex;
    padding: 10px;
    background: #ffffff;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
    transition: transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .hero__brand-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2xl);
  }

  .hero__brand-img {
    display: block;
    width: 96px;
    height: 96px;
  }

  @media (min-width: 768px) {
    .hero__brand-img {
      width: 116px;
      height: 116px;
    }
  }


  /* ── Dashboard Visual ────────────────────────────────────────────────────── */

  .hero__visual {
    flex: 1;
    max-width: 600px;
    width: 100%;
    position: relative;
  }

  .hero__ui {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl), 0 0 0 1px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 1;
  }

  /* Browser chrome */
  .hero__ui-chrome-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 8px 12px;
    background: var(--color-bg-dark);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__ui-dots {
    display: flex;
    gap: 6px;
  }

  .hero__ui-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
  }

  .hero__ui-dot--red { background: #f87171; }
  .hero__ui-dot--yellow { background: #fbbf24; }
  .hero__ui-dot--green { background: #34d399; }

  .hero__ui-url {
    flex: 1;
    max-width: 260px;
    text-align: center;
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-bg-subtle);
    padding: 4px var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-light);
  }

  .hero__ui-body {
    display: flex;
    min-height: 400px;
    background:
      radial-gradient(520px 220px at 8% 0%, rgba(16, 185, 129, 0.07), transparent 70%),
      var(--color-bg);
  }

  @media (min-width: 768px) {
    .hero__ui-body {
      min-height: 460px;
    }
  }

  /* ── Sidebar ─────────────────────────────────────────────────────────────── */

  .hero__ui-sidebar {
    width: 44px;
    background: linear-gradient(185deg, #064e3b 0%, #022c22 100%);
    padding: var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .hero__ui-sidebar {
      width: 168px;
      padding: var(--space-4) var(--space-3);
      align-items: stretch;
      gap: var(--space-4);
    }
  }

  .hero__ui-brand {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero__ui-brand {
      justify-content: flex-start;
      gap: var(--space-2);
      padding: var(--space-1);
    }
  }

  .hero__ui-brand-logo {
    width: 22px;
    height: 22px;
    border-radius: 6px;
  }

  .hero__ui-brand-name {
    display: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #fff;
  }

  @media (min-width: 768px) {
    .hero__ui-brand-name {
      display: inline;
    }
  }

  .hero__ui-nav-list {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__ui-nav-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 7px 0;
    border-radius: var(--radius-md);
    color: rgba(255, 255, 255, 0.72);
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
  }

  .hero__ui-nav-item svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .hero__ui-nav-item span {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .hero__ui-nav-item {
      justify-content: flex-start;
      padding: 8px var(--space-2);
      font-size: 11px;
    }
  }

  .hero__ui-nav-item--active {
    background: linear-gradient(90deg, rgba(52, 211, 153, 0.18), rgba(52, 211, 153, 0.04));
    color: #fff;
  }

  .hero__ui-nav-item--active::before {
    content: "";
    position: absolute;
    left: -10px;
    width: 3px;
    height: 16px;
    border-radius: var(--radius-full);
    background: #34d399;
  }

  .hero__ui-nav-footer {
    margin-top: auto;
    width: 100%;
  }

  /* ── Main content ────────────────────────────────────────────────────────── */

  .hero__ui-main {
    flex: 1;
    min-width: 0;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .hero__ui-main {
      padding: var(--space-5);
      gap: var(--space-4);
    }
  }

  /* Header: greeting + date + status chips */
  .hero__ui-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__ui-header-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
