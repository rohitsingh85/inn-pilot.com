---
import { config } from "@/lib/config";
---

<section class="final-cta section" id="get-started">
  <div class="container container--narrow">
    <div class="final-cta__inner reveal">
      <h2 class="final-cta__title">Ready to run your property on one system?</h2>
      <p class="final-cta__desc">
        Start with InnPilot Free. Operate, sell, and distribute from a single connected platform.
      </p>
      <div class="final-cta__actions">
        <a href={config.urls.requestAccess} class="btn btn--primary btn--lg" data-track="request_access_click">
          Request Access
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        {config.whatsapp.link && (
          <a
            href={config.whatsapp.link}
            class="btn btn--whatsapp btn--lg"
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp_final_cta"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Chat on WhatsApp
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta__inner {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    background: var(--color-bg-dark);
    border: 1px solid var(--color-bg-dark-elevated);
    border-radius: var(--radius-2xl);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .final-cta__inner::before {
    content: "";
    position: absolute;
    top: -40%;
    left: -20%;
    width: 140%;
    height: 180%;
    background: radial-gradient(
      ellipse at center,
      rgba(16, 185, 129, 0.1) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .final-cta__inner {
      padding: var(--space-16) var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .final-cta__inner {
      padding: var(--space-20) var(--space-16);
    }
  }

  .final-cta__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 800;
    margin-bottom: var(--space-4);
    color: white;
    position: relative;
  }

  .final-cta__desc {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.7);
    max-width: 480px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
    position: relative;
  }

  .final-cta__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    position: relative;
    flex-wrap: wrap;
  }
</style>
