---
import { config } from "@/lib/config";
---

<section class="final-cta section" id="get-started">
  <div class="container container--narrow">
    <div class="final-cta__inner reveal">
      <h2 class="final-cta__title">Ready to run your property on one system?</h2>
      <p class="final-cta__desc">
        Start with InnPilot Free. Operate, sell, and distribute from a single connected platform.
      </p>
      <div class="final-cta__actions">
        <a href={config.urls.startFree} class="btn btn--primary btn--lg">
          Get Started
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta__inner {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    background: var(--color-bg-dark);
    border: 1px solid var(--color-bg-dark-elevated);
    border-radius: var(--radius-2xl);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .final-cta__inner::before {
    content: "";
    position: absolute;
    top: -40%;
    left: -20%;
    width: 140%;
    height: 180%;
    background: radial-gradient(
      ellipse at center,
      rgba(16, 185, 129, 0.1) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .final-cta__inner {
      padding: var(--space-16) var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .final-cta__inner {
      padding: var(--space-20) var(--space-16);
    }
  }

  .final-cta__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 800;
    margin-bottom: var(--space-4);
    color: white;
    position: relative;
  }

  .final-cta__desc {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.7);
    max-width: 480px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
    position: relative;
  }

  .final-cta__actions {
    display: flex;
    justify-content: center;
    position: relative;
  }
</style>
