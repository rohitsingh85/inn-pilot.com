---
import { config } from "@/lib/config";

export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  descriptionMore?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  eyebrow,
  title,
  description,
  descriptionMore,
  primaryCta = { label: "Request Access", href: config.urls.requestAccess },
  secondaryCta = { label: "Log in", href: config.urls.signIn },
} = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <div class="page-hero__content">
      <span class="eyebrow reveal">{eyebrow}</span>
      <h1 class="page-hero__title reveal reveal-delay-1">{title}</h1>
      {description && (
        <p class="page-hero__desc reveal reveal-delay-2">{description}</p>
      )}
      {descriptionMore && (
        <p class="page-hero__desc page-hero__desc--more reveal reveal-delay-2">{descriptionMore}</p>
      )}
      <div class="page-hero__actions reveal reveal-delay-3">
        <a href={primaryCta.href} class="btn btn--primary btn--lg">
          {primaryCta.label}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={secondaryCta.href} class="btn btn--secondary">{secondaryCta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + var(--space-16));
    padding-bottom: var(--space-16);
    text-align: center;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding-top: calc(var(--header-height) + var(--space-20));
      padding-bottom: var(--space-20);
    }
  }

  @media (min-width: 1024px) {
    .page-hero {
      padding-top: calc(var(--header-height) + var(--space-24));
      padding-bottom: var(--space-24);
    }
  }

  .page-hero__content {
    max-width: 720px;
    margin-inline: auto;
  }

  .page-hero__title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .page-hero__desc {
    font-size: clamp(var(--text-base), 2vw, var(--text-lg));
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .page-hero__desc--more {
    font-size: var(--text-base);
    margin-top: calc(-1 * var(--space-4));
    margin-bottom: var(--space-10);
  }

  .page-hero__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

</style>
