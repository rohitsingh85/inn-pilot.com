---
import PricingGrid from "./PricingGrid.astro";
---

<section class="pricing section section--alt" id="pricing">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow reveal">Pricing</span>
      <h2 class="reveal reveal-delay-1">Plans that grow with your property.</h2>
      <p class="reveal reveal-delay-2">
        Start with the Free plan. Upgrade when you need automation, advanced revenue management,
        or multi-property capabilities.
      </p>
    </div>
    <PricingGrid />
  </div>
</section>
