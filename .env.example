# =============================================================================
# InnPilot Public Website — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── WhatsApp ──
# Include country code, no spaces or dashes. Example: 919899389636
# Leave empty to hide the WhatsApp button.
WHATSAPP_NUMBER=

# ── Analytics (Plausible) ──
# Your Plausible analytics domain (e.g. inn-pilot.com).
# Leave empty to disable analytics.
PUBLIC_ANALYTICS_DOMAIN=

# ── Request Access Form (Brevo API — server-side only) ──
# Brevo transactional email API key. Used by /api/request-access Pages Function.
# Get from https://app.brevo.com/account/api-keys → SMTP API → Generate new key.
# Must be set as a Cloudflare Pages secret (NOT a public env var).
BREVO_API_KEY=

# ── URLs (placeholders — update when SaaS routes are confirmed) ──
# These are centralized here so components never hardcode them.
PUBLIC_START_FREE_URL=https://app.inn-pilot.com/admin/login
PUBLIC_SIGN_IN_URL=https://app.inn-pilot.com/admin/login
PUBLIC_SaaS_APP_URL=https://app.inn-pilot.com
PUBLIC_WEBSITE_URL=https://inn-pilot.com
